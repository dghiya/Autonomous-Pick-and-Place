<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5e_robotiq">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur5e"/>
  
  <xacro:arg name="tf_prefix" default="" />
  <xacro:arg name="simulation_controllers" default="" />
  <xacro:arg name="ros_namespace" default="" />

  <!-- Import UR, Gazebo Control, and Robotiq macros -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro" />
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro" />
  <!-- Load the initial positions YAML file into a Xacro dictionary -->
  <xacro:property name="initial_positions_file" default="$(find pcl_perception)/config/initial_positions.yaml"/>
  <xacro:property name="initial_positions_dict" value="${xacro.load_yaml(initial_positions_file)}"/>

  <link name="world" />
  <link name="ground_plane">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="5 5 0"/></geometry>
      <material name="ground_white"><color rgba="1 1 1 0.5"/></material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry><box size="5 5 0"/></geometry>
    </collision>
  </link>

  <joint name="ground_plane_joint" type="fixed">
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="ground_plane"/>
  </joint>

  <!-- Instantiate the UR5e Arm -->
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
    safety_pos_margin="0.15"
    safety_k_position="20"
    force_abs_paths="true"
    >
    <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:ur_robot>

  <!-- Instantiate the Robotiq Gripper -->
  <xacro:robotiq_gripper name="RobotiqGripper" 
      prefix="" 
      parent="tool0" 
      use_fake_hardware="false" 
      sim_ignition="true"
      include_ros2_control="false">
       <origin xyz="0 0 0" rpy="0 0 0" />
  </xacro:robotiq_gripper>

  <link name="tcp_link"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="tool0"/>
    <child link="tcp_link"/>
    <origin xyz="0 0 0.163" rpy="0 0 0"/> 
  </joint>

  <!-- Fixed workcell fixtures: single source of truth for Gazebo and MoveIt -->
  <xacro:macro name="fixture_box" params="name sx sy sz x y z rgba">
    <link name="${name}">
      <visual>
        <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
        <material name="${name}_mat"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <geometry><box size="${sx} ${sy} ${sz}"/></geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="world"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:fixture_box name="table"     sx="0.8" sy="0.8"  sz="0.02" x="0.6" y="0.0"  z="0.40" rgba="0.4 0.2 0.1 1"/>
  <!-- <xacro:fixture_box name="drop_tray" sx="0.3" sy="0.25" sz="0.04" x="0.5" y="0.25" z="0.43" rgba="0.2 0.8 0.2 1"/> -->

  <!-- Gazebo Control Plugin -->
  <gazebo reference="world"/>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find ur5e_gripper_moveit_config)/config/ros2_controllers.yaml</parameters>
      <ros>
        <namespace>$(arg ros_namespace)</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- ROS 2 Control Hardware Interface -->
  <xacro:ur_ros2_control
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    transmission_hw_interface=""
    initial_positions="${initial_positions_dict['initial_positions']}"
  />

  <!-- Explicitly lock the gripper open at spawn so gravity doesn't pull it closed -->
  <!-- <ros2_control name="GazeboGripperSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="robotiq_85_left_knuckle_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/> -->

      <!-- Single gripper ros2_control block (macro's own block disabled above) -->
    <ros2_control name="GazeboGripperSystem" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="robotiq_85_left_knuckle_joint">
          <command_interface name="position"/>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
        </joint>
        <joint name="robotiq_85_right_knuckle_joint"/>
        <joint name="robotiq_85_left_inner_knuckle_joint"/>
        <joint name="robotiq_85_right_inner_knuckle_joint"/>
        <joint name="robotiq_85_left_finger_tip_joint"/>
        <joint name="robotiq_85_right_finger_tip_joint"/>
      </ros2_control>
    </robot>
