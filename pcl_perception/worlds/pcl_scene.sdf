<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="pcl_perception_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

   
    <model name="table">
      <static>true</static>
      <pose>0.6 0 0.4 0 0 0</pose> 
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.8 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.02</size></box></geometry>
          <material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_object">
      <pose>0.5 0.1 0.45 0 0 0</pose>
      <link name="link">
        <inertial><mass>2.0</mass></inertial> <!-- Increased to 2.0kg -->
        <collision name="collision">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>     <!-- High static friction -->
                <mu2>1.0</mu2>   <!-- High dynamic friction -->
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_object">
      <pose>0.50 -0.2 0.45 0 0 0</pose>
      <link name="link">
        <inertial><mass>2</mass></inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry>
          <surface><friction><ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.8 1</ambient><diffuse>0.1 0.1 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Drop-off Tray -->
    <model name="drop_tray">
      <static>true</static>
      <!-- Shifted left to y=0.35. Thickness increased to 4cm (z=0.43) to guarantee OctoMap visibility -->
      <pose>0.45 0.35 0.43 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.3 0.25 0.04</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.25 0.04</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Front-Left RealSense D435 -->
    <model name="realsense_front_left">
      <static>true</static>
      <pose>0.1 0.5 1.2 0 0.785 -0.785</pose>
      <link name="camera_link_fl">
        <visual name="visual">
          <geometry><box><size>0.025 0.09 0.025</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
        <sensor name="camera_fl" type="rgbd_camera">
          <topic>camera_fl</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.518</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>3.0</far></clip>
          </camera>
          <always_on>true</always_on><visualize>true</visualize>
        </sensor>
      </link>
    </model>

    <!-- Front-Right RealSense D435 -->
    <model name="realsense_front_right">
      <static>true</static>
      <pose>0.1 -0.5 1.2 0 0.785 0.785</pose>
      <link name="camera_link_fr">
        <visual name="visual">
          <geometry><box><size>0.025 0.09 0.025</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
        <sensor name="camera_fr" type="rgbd_camera">
          <topic>camera_fr</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.518</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>3.0</far></clip>
          </camera>
          <always_on>true</always_on><visualize>true</visualize>
        </sensor>
      </link>
    </model>

    <!-- Back-Left RealSense D435 -->
    <model name="realsense_back_left">
      <static>true</static>
      <pose>1.1 0.5 1.2 0 0.785 -2.356</pose>
      <link name="camera_link_bl">
        <visual name="visual">
          <geometry><box><size>0.025 0.09 0.025</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
        <sensor name="camera_bl" type="rgbd_camera">
          <topic>camera_bl</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.518</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>3.0</far></clip>
          </camera>
          <always_on>true</always_on><visualize>true</visualize>
        </sensor>
      </link>
    </model>

    <!-- Back-Right RealSense D435 -->
    <model name="realsense_back_right">
      <static>true</static>
      <pose>1.1 -0.5 1.2 0 0.785 2.356</pose>
      <link name="camera_link_br">
        <visual name="visual">
          <geometry><box><size>0.025 0.09 0.025</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
        <sensor name="camera_br" type="rgbd_camera">
          <topic>camera_br</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.518</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>3.0</far></clip>
          </camera>
          <always_on>true</always_on><visualize>true</visualize>
        </sensor>
      </link>
    </model>

  </world>
</sdf>